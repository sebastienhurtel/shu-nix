# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  nixos-hardware,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
    # ThinkPad T14 Gen 3 AMD (Ryzen 5 PRO 6650U / Radeon 680M):
    # amd_pstate, amdgpu initrd, hardware.graphics (+32bit), trackpoint, fstrim, tlp default
    nixos-hardware.nixosModules.lenovo-thinkpad-t14-amd-gen3
  ];

  boot.loader = {
    systemd-boot.enable = true;
    efi.canTouchEfiVariables = true;
  };
  boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "usb_storage" "usbhid" "sd_mod" ];
  boot.initrd.kernelModules = [ "dm-snapshot" ];
  boot.initrd.luks.devices.luksroot = {
    preLVM = true;
    device = "/dev/disk/by-uuid/3cdb419d-d809-4753-8048-76299c1b2bf0";
  };
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];
  boot.kernelPackages = pkgs.linuxPackages_latest;

  fileSystems."/" =
    { device = "/dev/mapper/vg--fedora-root";
      fsType = "ext4";
    };

  fileSystems."/boot" = { device = "/dev/disk/by-uuid/AC01-EA64"; fsType = "vfat"; options = [ "fmask=0022" "dmask=0022" ]; };

  fileSystems."/nix" =
    { device = "/dev/mapper/vg--fedora-nix";
      fsType = "ext4";
    };

  fileSystems."/home" =
    { device = "/dev/mapper/vg--fedora-home";
      fsType = "ext4";
    };

  fileSystems."/tmp" =
    { device = "/dev/mapper/vg--fedora-tmp";
      fsType = "ext4";
    };

  fileSystems."/var" =
    { device = "/dev/mapper/vg--fedora-var";
      fsType = "ext4";
    };

  swapDevices = [ ];
  zramSwap.enable = true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
  system.stateVersion = "26.05";
}
